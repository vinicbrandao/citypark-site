# Copy to supabase/.env.auth-smtp.local (ignored by Git).
# Resend test sender: only the e-mail used to create your Resend account can receive.
# Replace FROM with an address on your verified domain before sending to customers.
CITYPARK_AUTH_SMTP_HOST=smtp.resend.com
CITYPARK_AUTH_SMTP_PORT=587
CITYPARK_AUTH_SMTP_USER=resend
CITYPARK_AUTH_SMTP_PASS=
CITYPARK_AUTH_SMTP_FROM=onboarding@resend.dev
CITYPARK_AUTH_SMTP_SENDER_NAME="CityPark Exclusive"
