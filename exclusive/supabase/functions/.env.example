# Edge Functions only. Copy to .env.local and pass --env-file when serving.
# Values are server secrets. Never use a VITE_ prefix here.
DEADLINE_REMINDER_TOKEN=
# Official cloud: resend. Local mock tests default to webhook.
DEADLINE_EMAIL_PROVIDER=resend
RESEND_API_KEY=
DEADLINE_EMAIL_FROM="City Park Exclusive <nao-responda@acesso.cityparkmcz.com.br>"
# Only needed when DEADLINE_EMAIL_PROVIDER=webhook:
DEADLINE_EMAIL_WEBHOOK_URL=
DEADLINE_EMAIL_WEBHOOK_TOKEN=
